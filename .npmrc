# @langchain/community pulls in optional integrations (e.g. @browserbasehq/stagehand)
# whose peer dependency on zod ^3.x conflicts with the zod ^4.x required by
# @langchain/anthropic/@langchain/classic/etc, which this project actually uses.
# legacy-peer-deps avoids hard ERESOLVE failures from those unused optional peers.
legacy-peer-deps=true
