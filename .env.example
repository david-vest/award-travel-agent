# Required
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=award-travel-agent
LANGSMITH_TRACING=true

# Optional — downvotes use this queue directly. Without an ID, Roam finds or
# creates LANGSMITH_ANNOTATION_QUEUE_NAME instead.
# LANGSMITH_ANNOTATION_QUEUE_ID=
# LANGSMITH_ANNOTATION_QUEUE_NAME=roam-uat-failures
# LANGSMITH_FEEDBACK_DATASET=roam-reviewed-recommendation-failures

# Optional — absent means the app runs entirely on recorded fixtures
SEATS_AERO_API_KEY=

# Optional — omit all inputs/outputs from every LangSmith trace (coarse: all
# or nothing, applies to both the LangSmith SDK and LangChain). Useful if
# trace content — which can include point balances and trip details — is a
# concern for this deployment. Fine-grained redaction (mask only specific
# fields, keep the rest of the trace) requires wiring a custom LangSmith
# Client with hideInputs/hideOutputs into the graph's tracing config, which
# is not done here.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
